MOCK_MODE=false
# Port host backend — khớp BACKEND_PORT trong .env gốc (mặc định 8081)
BACKEND_URL=http://localhost:8081
DEV_USER_EMAIL=user@gmail.com
DEV_USER_PASSWORD=user1234

# JWT — phải khớp backend/.env (middleware verify access token trên edge)
JWT_KEY=dev-jwt-key-change-me-in-production-32b
JWT_ISSUER=Taskflow
JWT_AUDIENCE=TaskflowClient

# Playwright e2e (optional — playwright.config.ts có default)
# DATABASE_URL=postgresql://postgres:taskflow@localhost:5434/taskflow_db?sslmode=disable
# E2E_BACKEND_PORT=8099
# E2E_ADMIN_EMAIL=admin@gmail.com
# E2E_ADMIN_PASSWORD=admin123
# E2E_MOCK_MODE=true   # chỉ khi chạy npm run test:e2e:mock (không cần Postgres)
