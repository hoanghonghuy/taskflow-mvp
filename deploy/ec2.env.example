# Public hostname that points to this EC2 public IP.
# Example: taskflow-huy.duckdns.org
APP_DOMAIN=taskflow.example.com

POSTGRES_DB=taskflow_db
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Use a long random secret (at least 32 bytes recommended).
JWT_KEY=replace-with-a-long-random-jwt-secret
JWT_ISSUER=Taskflow
JWT_AUDIENCE=TaskflowClient

# AI provider: gemini or openai/openai-compatible according to backend config.
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional bootstrap users. Leave blank to disable seeding.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=System Admin
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_NAME=Demo User
