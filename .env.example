# =============================================================================
# Taskflow MVP - Root Environment Variables
# =============================================================================
# Docker Compose dùng file này làm nguồn env cho full-Docker và local infra mode.

# --- General ---
MOCK_MODE=false
BACKEND_URL=http://localhost:8081

# --- JWT Configuration ---
JWT_KEY=dev-jwt-key-change-me-in-production-32b
JWT_ISSUER=Taskflow
JWT_AUDIENCE=TaskflowClient

# --- Database (PostgreSQL) ---
# Host machine connection
DATABASE_URL=postgresql://postgres:taskflow@localhost:5434/taskflow_db?sslmode=disable
# Docker internal connection (backend container -> postgres service)
DATABASE_URL_DOCKER=postgres://postgres:taskflow@postgres:5432/taskflow_db?sslmode=disable

# --- AI Provider Configuration ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- CORS ---
CORS_ORIGIN=http://localhost:3000

# --- Encryption Key (for user secrets) ---
USER_SECRET_ENC_KEY=

# --- Demo User Seeding ---
DEMO_EMAIL=demo@taskflow.app
DEMO_PASSWORD=Demo123@
DEMO_NAME=Demo User
DEMO_SEED_FORCE=false

# --- Admin User Seeding ---
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=System Admin

# --- Frontend / Backend Ports ---
FRONTEND_PORT=3000
BACKEND_PORT=8081

# --- PostgreSQL Ports ---
POSTGRES_DB=taskflow_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=taskflow
POSTGRES_PORT=5434

# --- Docker Internal URLs ---
BACKEND_INTERNAL_URL=http://backend:8080

# --- Next.js ---
NEXT_DIST_DIR=.next
