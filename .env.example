# Ports (docker-compose)
FRONTEND_PORT=3000
# Host port — 8081 tránh trùng iris-api (8080)
BACKEND_PORT=8081

# PostgreSQL — cùng image postgres:16-alpine như iris-app (port host khác để tránh trùng)
POSTGRES_DB=taskflow_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=taskflow
POSTGRES_PORT=5434

# Local dev (host → container postgres)
DATABASE_URL=postgresql://postgres:taskflow@localhost:5434/taskflow_db?sslmode=disable

# Docker nội bộ (backend container → postgres service)
DATABASE_URL_DOCKER=postgres://postgres:taskflow@postgres:5432/taskflow_db?sslmode=disable

# Frontend container → backend service (trong Docker network)
BACKEND_INTERNAL_URL=http://backend:8080

# Frontend trong compose (MOCK_MODE đọc từ đây hoặc frontend/.env)
MOCK_MODE=false
