PORT=8080
NODE_ENV=development

JWT_KEY=dev-jwt-key-change-me-in-production-32b
JWT_ISSUER=Taskflow
JWT_AUDIENCE=TaskflowClient

# PostgreSQL (mặc định — chạy: docker compose up -d postgres)
DATABASE_URL=postgresql://postgres:taskflow@localhost:5434/taskflow_db?sslmode=disable

# Trong docker-compose backend dùng DATABASE_URL_DOCKER (ghi đè DATABASE_URL)
DATABASE_URL_DOCKER=postgres://postgres:taskflow@postgres:5432/taskflow_db?sslmode=disable

# SQLite — chỉ tham chiếu (schema.sqlite.prisma), không dùng runtime
# DATABASE_URL_SQLITE_REFERENCE=file:./data/taskflow.db

GEMINI_API_KEY=

CORS_ORIGIN=http://localhost:3000
