PORT=8080
NODE_ENV=development

JWT_KEY=dev-jwt-key-change-me-in-production-32b
JWT_ISSUER=Taskflow
JWT_AUDIENCE=TaskflowClient

# PostgreSQL (mặc định — chạy: docker compose up -d postgres)
DATABASE_URL=postgresql://postgres:taskflow@localhost:5434/taskflow_db?sslmode=disable

# Trong docker-compose backend dùng DATABASE_URL_DOCKER (ghi đè DATABASE_URL)
DATABASE_URL_DOCKER=postgres://postgres:taskflow@postgres:5432/taskflow_db?sslmode=disable

# SQLite — chỉ tham chiếu (schema.sqlite.prisma), không dùng runtime
# DATABASE_URL_SQLITE_REFERENCE=file:./data/taskflow.db

# AI provider: gemini (default) | openai | openai-compatible
AI_PROVIDER=gemini
GEMINI_API_KEY=

# OpenAI-compatible (OpenAI, Ollama, LM Studio, v.v.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

CORS_ORIGIN=http://localhost:3000

# Tài khoản admin mặc định (tạo lúc backend khởi động nếu chưa tồn tại)
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=System Admin

# Tài khoản demo (USER thường + dữ liệu mẫu — tạo lúc backend khởi động)
DEMO_EMAIL=demo@taskflow.app
DEMO_PASSWORD=Demo123@
DEMO_NAME=Demo User
# DEMO_SEED_FORCE=true  # xóa và seed lại data demo nếu user đã có task
