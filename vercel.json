{
  "version": 2,
  "builds": [
    {
      "src": "taskflow-frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/taskflow-frontend/$1"
    }
  ],
  "installCommand": "cd taskflow-frontend && npm install",
  "buildCommand": "cd taskflow-frontend && npm run build",
  "outputDirectory": "taskflow-frontend/dist",
  "framework": null
}
