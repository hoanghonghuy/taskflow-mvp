[Unit]
Description=Taskflow local dev stack with tmux sessions
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/taskflow-mvp
Environment=HOME=/home/ubuntu
ExecStart=/home/ubuntu/taskflow-mvp/scripts/start-local-dev-tmux.sh
ExecStop=/home/ubuntu/taskflow-mvp/scripts/stop-local-dev-tmux.sh
RemainAfterExit=yes
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
